# Copy to .env (git-ignored). Everything is optional for `--dry-run`.

# ---- Agent 1: Domain Flipper ------------------------------------------------
# Where dropped domains come from: auto | whoisfreaks | whoisfreaks-free
#   whoisfreaks-free = public GitHub sample (10k/day, partial gTLDs), no key, free
#   whoisfreaks      = full feed, needs the paid Domainer package + WHOISFREAKS_API_KEY
#   auto             = whoisfreaks when the key is set, else whoisfreaks-free
DOMAIN_SOURCE=auto
# Where authority metrics come from: auto | dataforseo | openpagerank | none
#   openpagerank = free API key from openpagerank.com (0..10 score, no link counts)
#   dataforseo   = paid, gives DR-like rank plus referring domains and backlinks
#   auto         = dataforseo if its credentials are set, else openpagerank if its key is set, else none
AUTHORITY_SOURCE=auto
OPENPAGERANK_API_KEY=
WHOISFREAKS_API_KEY=
# DataForSEO: either login/password or a prebuilt base64("login:password")
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_AUTH=
DOMAIN_TLDS=com,ai
DOMAIN_MAX_LENGTH=20
DOMAIN_MIN_DR=10
DOMAIN_MIN_REFERRING_DOMAINS=5
# Max paid (DataForSEO) lookups per run; the most brandable names are checked first
DOMAIN_MAX_ENRICH=400
# Max free Open PageRank lookups per run (100 per API call)
DOMAIN_MAX_OPENPAGERANK=5000
# Max candidates sent to the OpenAI scorer per run (heuristic pre-ranks the rest)
DOMAIN_MAX_LLM_SCORE=100
DOMAIN_TOP_N=5
# DataForSEO rank is 0..1000; divide by 10 to approximate a 0..100 DR. Set to 1 for a vendor that already returns DR.
DR_SCALE_DIVISOR=10
# Comma-separated extra prefixes/substrings to reject (added to the built-in trademark list)
DOMAIN_BLOCKLIST=
SLACK_CHANNEL_DOMAIN=#domain-arbitrage-radar
SLACK_WEBHOOK_URL_DOMAIN=

# ---- Agent 2: Dead SaaS Scout ----------------------------------------------
# Sources, comma-separated: file | acquire | chromewebstore
SAAS_SOURCES=file
SAAS_LISTINGS_FILE=
CHROME_EXTENSION_IDS=
ACQUIRE_MAX_LISTINGS=150
BUILTWITH_API_KEY=
SIMILARWEB_API_KEY=
SAAS_MAX_ASKING_PRICE=10000
SAAS_MIN_INACTIVE_DAYS=540
SAAS_MIN_CLAIMED_USERS=1000
SAAS_REQUIRE_PRICE=false
SAAS_MIN_MONTHLY_VISITS=800
SAAS_MIN_INSTALLS=1200
SAAS_MIN_SCORE=7
SAAS_MIN_REWRITE_POTENTIAL=8
SAAS_TOP_N=3
SLACK_CHANNEL_SAAS=#saas-acquisitions
SLACK_WEBHOOK_URL_SAAS=

# ---- Shared ------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL_DOMAIN=gpt-4o-mini
OPENAI_MODEL_SAAS=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1
# Fallback webhook used by both agents when the per-agent one is empty
SLACK_WEBHOOK_URL=
# Or a bot token (needs chat:write) + the SLACK_CHANNEL_* above
SLACK_BOT_TOKEN=
# Optional Apps Script web-app URL that appends POSTed {"rows": [...]} to a sheet
GOOGLE_SHEETS_WEBHOOK_URL=
AGENTS_CACHE_PATH=.cache/agents.sqlite
AUDIT_LOG_DIR=logs
